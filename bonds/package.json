{
  "name": "bonds-page",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i input.css -o bonds.css --minify",
    "build:js": "esbuild src/app.jsx --bundle --minify --loader:.jsx=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=bonds.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "jsdom": "^31.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
